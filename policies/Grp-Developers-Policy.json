{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowEC2AndS3ManagementInUsEast1Only",
      "Effect": "Allow",
      "Action": [
        "ec2:StartInstances",
        "ec2:StopInstances",
        "ec2:RebootInstances",
        "ec2:Describe*",
        "s3:ListAllMyBuckets",
        "s3:ListBucket",
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "ExplicitlyDenyPrivilegeEscalationAndIAMChanges",
      "Effect": "Deny",
      "Action": [
        "iam:*",
        "organization:*"
      ],
      "Resource": "*"
    }
  ]
}
